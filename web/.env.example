# Backend (universal-backend) base URL, without trailing slash. Server-side only.
HALOHUB_API_URL=http://localhost:3000
# Bearer token for /halohub/api/* and /halohub/jobs/*. Never exposed to the browser.
HALOHUB_ADMIN_TOKEN=change-me
# HTTP Basic password for /[lang]/panel (any username). Unset -> panel answers 503.
PANEL_PASSWORD=change-me
